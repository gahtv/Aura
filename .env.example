# Copy to .env (gitignored) and fill in real values.
# Each KEY=VALUE here becomes a BuildConfig.KEY String field in the app.
# Example:
# LYRICS_API_KEY=abcd1234
# Lyrics fallback (LRCLIB). Client-side app id from https://lrclib.net/dashboard;
# public, rate-limit identifier (180 req/min vs ~45 anonymous).
# LRCLIB_APP_ID=your-app-id
